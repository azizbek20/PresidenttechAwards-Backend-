# EYE DETECT AI backend — example environment (SPEC.md §4.9 / §5-D D1)
#
#   cp .env.example .env   &&   edit .env
#
# Every variable below is a real field of `app/config.py`. PLACEHOLDERS ONLY —
# never commit a populated `.env` (it is in .gitignore and .dockerignore) and
# never paste a real key into this file.
#
# `.env` is read twice: by pydantic-settings for the app, and by `docker
# compose` for ${VAR} substitution. Values with `#` or spaces must be quoted.

# ===========================================================================
# mode / model  (C9 — no silent fallback)
# ===========================================================================

# demo   -> the mock engine is allowed; every response carries mode="demo".
# shadow -> never serves mock output and refuses to boot with
#           EYE_MODEL_SOURCE=mock. With claude it also needs a non-empty
#           EYE_API_KEY.
EYE_MODE=demo

# mock | claude. `torch` is a legacy value that always answers 503. The v1
# `auto` source is DELETED on purpose.
EYE_MODEL_SOURCE=mock

# Holds the optional /analyze skin model (analysis/skin.onnx). Mounted
# READ-ONLY into the container at /app/models. The DR engines need no weights.
EYE_MODEL_DIR=./models

# Legacy torch source only (required with it in shadow mode). Leave EMPTY.
EYE_MODEL_SHA256=

# Reported by the mock engine in every response and stored with each result
# row. The Claude engine reports <CLAUDE_MODEL>/prompt-<PROMPT_VERSION>.
EYE_MODEL_VERSION=mock-v0

# Legacy: no engine reads it since the torch engine was removed. Keep cpu.
EYE_DEVICE=cpu

# Square input edge fed to the mock engine (64..1024).
EYE_INPUT_SIZE=224

# ===========================================================================
# Claude engine (EYE_MODEL_SOURCE=claude)
# ===========================================================================

# Your Anthropic key. Set it only here in .env (git-ignored) or in the shell;
# never in a tracked file. Without it the app starts, but /health/ready and
# /api/v1/predict answer 503.
ANTHROPIC_API_KEY=

# claude-sonnet-5-5 (default) | claude-opus-5-5 for comparison runs.
CLAUDE_MODEL=claude-sonnet-5-5

# Per-request timeout in seconds. No automatic retries: the phone has its own.
CLAUDE_TIMEOUT_S=25

# Thinking tokens count toward this cap; an answer cut off by it is a 500.
CLAUDE_MAX_TOKENS=4000

# Selects app/inference/prompts/fundus_<version>.md. Bump it whenever the
# prompt changes, so model_version shows which prompt made each verdict.
PROMPT_VERSION=v1

# true: a grade-2 lesion Claude marks "uncertain" refers (sensitivity-first).
UNCERTAIN_REFERS=true

# ===========================================================================
# api
# ===========================================================================

# X-API-Key expected on /api/v1/*. Empty = auth DISABLED (a startup WARNING is
# logged). /health and /static are never authenticated (Coil sends no key).
# CHANGE THIS before exposing the port to a LAN. This value is a placeholder.
EYE_API_KEY=change-me-demo-key

# Optional second key, sent as X-Admin-Key, for /api/v1/exams and
# /api/v1/exams/{id} (every exam and its photo URL; only the admin panel calls
# them). Empty = the app key alone is enough there. Must differ from
# EYE_API_KEY, which ships inside the APK. Set it in any real deployment.
EYE_ADMIN_API_KEY=

# Upload cap in MB (1..100). The client compresses to ~200-600 KB.
MAX_UPLOAD_MB=10

# Concurrent inferences (1..32). Keep at or below the CPU core count.
INFERENCE_CONCURRENCY=2

# C14 dedup window in minutes (0..1440). Re-POSTing the same bytes with the
# same patient/eye inside this window replays the stored exam instead of
# creating a duplicate. 0 disables dedup.
DEDUP_WINDOW_MIN=10

# ===========================================================================
# clinical thresholds — SERVER SIDE ONLY
# The phone never re-derives a verdict; it renders `decision`. Changing the
# threshold here changes every device at once, with no app release.
# ===========================================================================

# P(referable) >= this -> REFER. Sensitivity-first: lower it to refer more.
EYE_REFERABLE_THRESHOLD=0.5

# Laplacian-variance floor for the quality gate. Below it -> UNGRADABLE, and
# the DR engine is never invoked.
# Calibrated on real fundus photos (IDRiD, 516 images, measured at the gate's
# 512-px working size): sharp images p5 = 16.4, median = 34.8; Gaussian
# defocus sigma=2 (at 1024 px) p95 = 6.2. The config.py default of 50 rejects
# 64% of sharp real fundus photos (85% of grade-4 ones) — fundus images are
# smooth by nature — so a deployment with a real model must use ~8.
QUALITY_BLUR_MIN_VAR=8.0

# ===========================================================================
# infra
# ===========================================================================

# SQLite for demo. Postgres under the `prod` compose profile, e.g.
#   postgresql+psycopg://eye:CHANGE-ME@postgres:5432/eye
# and on Vercel (see .env.vercel.example).
#
# This host-relative value is for running `uvicorn` directly on your machine.
# docker-compose.yml deliberately IGNORES it and forces
# sqlite:////app/data/eye.db, so the database sits on its own volume and
# survives `compose down`. Do not "fix" that by re-adding a
# ${DATABASE_URL:-...} default there — it silently emptied the admin panel.
DATABASE_URL=sqlite:///./eye.db

# local (default): originals land in <dir>/images and are served at /static.
# blob: Vercel Blob (needs BLOB_READ_WRITE_TOKEN); nothing is written locally.
EYE_STORAGE=local
EYE_STORAGE_DIR=./storage

# ===========================================================================
# compose-only (NOT read by app/config.py)
# ===========================================================================

# Host ports.
API_PORT=8000
ADMIN_PORT=8501

# Where admin/dashboard.py reaches the API. Inside the compose network use the
# service name; from your laptop use http://localhost:8000.
API_URL=http://api:8000

# `prod` profile only. PLACEHOLDER — generate a real password out of band and
# keep it out of git.
POSTGRES_DB=eye
POSTGRES_USER=eye
POSTGRES_PASSWORD=change-me-not-a-real-password
