# EYE DETECT AI backend — example environment (SPEC.md §4.9 / §5-D D1)
#
#   cp .env.example .env   &&   edit .env
#
# Every variable below is a real field of `app/config.py`. PLACEHOLDERS ONLY —
# never commit a populated `.env` (it is in .gitignore and .dockerignore) and
# never paste a real key into this file.
#
# `.env` is read twice: by pydantic-settings for the app, and by `docker
# compose` for ${VAR} substitution. Values with `#` or spaces must be quoted.

# ===========================================================================
# mode / model  (C9 — no silent fallback)
# ===========================================================================

# demo   -> the mock engine is allowed; every response carries mode="demo".
# shadow -> REQUIRES EYE_MODEL_SOURCE=torch and EYE_MODEL_SHA256, and refuses
#           to boot otherwise. Never serves mock output.
EYE_MODE=demo

# mock | torch. The v1 `auto` source is DELETED on purpose.
EYE_MODEL_SOURCE=mock

# Where checkpoints live. Mounted READ-ONLY into the container at /app/models.
EYE_MODEL_DIR=./models

# SHA-256 of the checkpoint, verified before load. Mandatory in shadow mode.
# Leave EMPTY in demo mode. Placeholder below is not a real digest.
EYE_MODEL_SHA256=

# Reported in every response and stored with each result row.
EYE_MODEL_VERSION=mock-v0

# cpu (default, MANDATORY for tests/CI/Docker/gates) | mps (Apple-silicon dev
# runs only) | auto. Grad-CAM always runs on cpu regardless.
EYE_DEVICE=cpu

# Square input edge fed to the model (64..1024).
EYE_INPUT_SIZE=224

# ===========================================================================
# api
# ===========================================================================

# X-API-Key expected on /api/v1/*. Empty = auth DISABLED (a startup WARNING is
# logged). /health and /static are never authenticated (Coil sends no key).
# CHANGE THIS before exposing the port to a LAN. This value is a placeholder.
EYE_API_KEY=change-me-demo-key

# Upload cap in MB (1..100). The client compresses to ~200-600 KB.
MAX_UPLOAD_MB=10

# Concurrent inferences (1..32). Keep at or below the CPU core count.
INFERENCE_CONCURRENCY=2

# C14 dedup window in minutes (0..1440). Re-POSTing the same bytes with the
# same patient/eye inside this window replays the stored exam instead of
# creating a duplicate. 0 disables dedup.
DEDUP_WINDOW_MIN=10

# ===========================================================================
# clinical thresholds — SERVER SIDE ONLY
# The phone never re-derives a verdict; it renders `decision`. Changing the
# threshold here changes every device at once, with no app release.
# ===========================================================================

# P(referable) >= this -> REFER. Sensitivity-first: lower it to refer more.
EYE_REFERABLE_THRESHOLD=0.5

# Laplacian-variance floor for the quality gate. Below it -> UNGRADABLE, and
# the DR engine is never invoked.
QUALITY_BLUR_MIN_VAR=50.0

# ===========================================================================
# infra
# ===========================================================================

# SQLite for demo. Postgres only under the `prod` compose profile, e.g.
#   postgresql+psycopg://eye:CHANGE-ME@postgres:5432/eye
#
# This host-relative value is for running `uvicorn` directly on your machine.
# docker-compose.yml deliberately IGNORES it and forces
# sqlite:////app/storage/eye.db, so the database sits on the storage volume
# and survives `compose down`. Do not "fix" that by re-adding a
# ${DATABASE_URL:-...} default there — it silently emptied the admin panel.
DATABASE_URL=sqlite:///./eye.db

# Originals and heatmaps land in <dir>/images and <dir>/heatmaps.
EYE_STORAGE_DIR=./storage

# ===========================================================================
# compose-only (NOT read by app/config.py)
# ===========================================================================

# Host ports.
API_PORT=8000
ADMIN_PORT=8501

# Where admin/dashboard.py reaches the API. Inside the compose network use the
# service name; from your laptop use http://localhost:8000.
API_URL=http://api:8000

# `prod` profile only. PLACEHOLDER — generate a real password out of band and
# keep it out of git.
POSTGRES_DB=eye
POSTGRES_USER=eye
POSTGRES_PASSWORD=change-me-not-a-real-password
