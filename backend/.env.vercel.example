# EYE DETECT AI backend — Vercel (Production) environment, Claude engine.
#
# Copy these NAMES into Vercel → Project → Settings → Environment Variables.
# PLACEHOLDERS ONLY. Never commit real values; never paste the Anthropic key
# into a chat, a prompt, a test or a log.
#
# For local runs, put the same names in backend/.env (git-ignored).

# --- mode / engine ----------------------------------------------------------
EYE_MODE=shadow
EYE_MODEL_SOURCE=claude
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
CLAUDE_TIMEOUT_S=25
# Thinking tokens count toward this cap; you pay only for tokens used.
CLAUDE_MAX_TOKENS=4000
PROMPT_VERSION=v1
UNCERTAIN_REFERS=true

# --- api ----------------------------------------------------------------------
# openssl rand -hex 32 ; the SAME value goes into the app's local.properties
# as API_KEY. Shadow mode refuses to boot without it.
EYE_API_KEY=
# A DIFFERENT openssl rand -hex 32. Never in the APK: only the admin panel uses
# it (X-Admin-Key) for /api/v1/exams*, which list every exam and photo URL.
EYE_ADMIN_API_KEY=
# Vercel itself rejects request bodies over 4.5 MB.
MAX_UPLOAD_MB=4
INFERENCE_CONCURRENCY=2
DEDUP_WINDOW_MIN=10

# --- clinical thresholds (server side only) ----------------------------------
EYE_REFERABLE_THRESHOLD=0.5
# The config default (50) rejects most sharp real fundus photos; 8 is the
# team's IDRiD calibration (see .env.example).
QUALITY_BLUR_MIN_VAR=8

# --- infra ---------------------------------------------------------------------
# Pooled Postgres URL from your provider. postgres:// is rewritten to
# postgresql+psycopg:// by the config.
DATABASE_URL=
EYE_STORAGE=blob
# Added automatically by Vercel when you connect a Blob store to the project.
BLOB_READ_WRITE_TOKEN=
